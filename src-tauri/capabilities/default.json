{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: only LibreRoom's own commands (AI model install/run) are callable.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-model-installed",
    "allow-install-model",
    "allow-remove-model",
    "allow-run-model",
    "allow-selftest-report",
    "allow-selftest-mark"
  ]
}
